    <experiment name="OppBothFocal125Alt375" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="20000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>total-dist</metric>
        <metric>handling-time</metric>
